<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- local_auth 需要 AppCompat 主题（Android 8 及以下否则崩溃） -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
    <!-- 生物识别跳板：透明，不留在最近任务里。主界面本身仍然出现在最近任务。 -->
    <style name="Theme.VaultAuth" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- 工具箱账号编辑：半透明底部卡片，不进最近任务 -->
    <style name="Theme.ToolboxEdit" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- 覆盖 Bcore 的 BTheme：分身 ProxyActivity 用。
         targetSdk 36 下系统默认 edge-to-edge，透明 NoTitleBar 会让分身顶栏钻进状态栏。
         运行时 CloneWindowFix 还会再强制 decorFitsSystemWindows。 -->
    <style name="BTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
</resources>
